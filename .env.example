# Todas as variáveis são opcionais. Sem elas, o app pede a URL e o token na tela Conexão.

# URL do servidor uazapi (sem barra no final)
UAZAPI_URL=

# Token da instância (Instance Token) gerado no painel do uazapi
UAZAPI_TOKEN=

# Senha para proteger o acesso ao app. Deixe vazio para desabilitar.
APP_PASSWORD=
