# URL do servidor uazapi (sem barra no final)
UAZAPI_URL=https://seu-servidor.uazapi.com

# Token da instância (Instance Token) gerado no painel do uazapi
UAZAPI_TOKEN=coloque-o-token-da-instancia-aqui

# Opcional: senha para proteger o acesso ao app. Deixe vazio para desabilitar.
APP_PASSWORD=

# Opcional: pasta onde ficam o banco (db.json) e os anexos enviados
# DATA_DIR=./data
